# ---- Runtime mode ----
DEMO_MODE=true

# ---- Supabase (leave blank to run fully in demo mode) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- Weather ----
# OpenWeatherMap-compatible API. Leave blank to use demo weather data.
WEATHER_API_KEY=
WEATHER_API_BASE=https://api.openweathermap.org/data/2.5

# ---- GIS data source adapters (all optional, all fall back to demo) ----
ISRO_API_KEY=
BHUVAN_API_KEY=
BHUSANKET_API_KEY=
GEE_SERVICE_ACCOUNT_JSON=

# ---- CORS ----
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ---- Frontend (used by frontend/index.html) ----
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=
